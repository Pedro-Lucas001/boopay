// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Merchant {
  id                    Int       @id @default(autoincrement())
  nome                  String
  razao_social          String
  email                 String    @unique
  status                String    @default("ativo")
  consumer_key          String
  consumer_secretHash   String
  data_criacao          DateTime  @default(now())
  data_atualizacao      DateTime  @updatedAt

  produtos              Product[]
  connectionCodes       ConnectionCode[]
  integrations          Integration[]
}

model ConnectionCode {
  id          String   @id @default(uuid())
  codeHash    String   @unique
  tenantId    String
  merchantId  Int
  storeUrl    String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  @@index([expiresAt])
}

model Integration {
  id              String    @id @default(uuid())
  tenantId        String
  merchantId      Int
  storeUrl        String
  tokenHash       String    @unique
  encryptedSecret String
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  merchant        Merchant  @relation(fields: [merchantId], references: [id])
  catalog         CatalogItem[]
  receipts        CatalogReceipt[]
  events          StoreEvent[]
  @@index([tenantId, merchantId])
}

model ReplayNonce {
  id        String   @id
  expiresAt DateTime
  @@index([expiresAt])
}

model Product {
  id               Int       @id @default(autoincrement())
  sku_woocommerce  String    @unique
  nome             String
  descricao        String?
  preco            Decimal
  estoque          Int       @default(0)
  url_loja_origem  String
  status           String    @default("ativo")
  data_criacao     DateTime  @default(now())
  data_atualizacao DateTime  @updatedAt

  merchant_id      Int
  merchant         Merchant  @relation(fields: [merchant_id], references: [id])
}

// Product é legado. Novos envios usam integração + ID WooCommerce.
model CatalogItem {
  id            String @id @default(uuid())
  integrationId String
  sourceId      Int
  revision      BigInt
  deleted       Boolean @default(false)
  snapshot      String
  updatedAt     DateTime @updatedAt
  integration   Integration @relation(fields: [integrationId], references: [id])
  @@unique([integrationId, sourceId])
}
model CatalogReceipt {
  id            String @id @default(uuid())
  integrationId String
  eventId       String
  payloadHash   String
  createdAt     DateTime @default(now())
  integration   Integration @relation(fields: [integrationId], references: [id])
  @@unique([integrationId, eventId])
}
model StoreEvent {
  id            String @id @default(uuid())
  integrationId String
  eventId       String
  payloadHash   String
  kind          String
  sessionHash   String
  productId     Int?
  occurredAt    DateTime
  receivedAt    DateTime @default(now())
  integration   Integration @relation(fields: [integrationId], references: [id])
  @@unique([integrationId, eventId])
}
