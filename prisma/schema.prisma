// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Merchant {
  id                    Int       @id @default(autoincrement())
  nome                  String
  razao_social          String
  email                 String    @unique
  status                String    @default("ativo")
  consumer_key          String
  consumer_secretHash   String
  data_criacao          DateTime  @default(now())
  data_atualizacao      DateTime  @updatedAt

  produtos              Product[]
  connectionCodes       ConnectionCode[]
  integrations          Integration[]
}

model ConnectionCode {
  id          String   @id @default(uuid())
  codeHash    String   @unique
  tenantId    String
  merchantId  Int
  storeUrl    String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  @@index([expiresAt])
}

model Integration {
  id              String    @id @default(uuid())
  tenantId        String
  merchantId      Int
  storeUrl        String
  tokenHash       String    @unique
  encryptedSecret String
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  merchant        Merchant  @relation(fields: [merchantId], references: [id])
  @@index([tenantId, merchantId])
}

model Product {
  id               Int       @id @default(autoincrement())
  sku_woocommerce  String    @unique
  nome             String
  descricao        String?
  preco            Decimal
  estoque          Int       @default(0)
  url_loja_origem  String
  status           String    @default("ativo")
  data_criacao     DateTime  @default(now())
  data_atualizacao DateTime  @updatedAt

  merchant_id      Int
  merchant         Merchant  @relation(fields: [merchant_id], references: [id])
}
